# Copy to .env. NEVER commit real keys.
CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# EMBEDDER=ollama            # ollama | hash
# Identity is AWS Cognito. Without these every request is a 401 and the app logs
# cognito_not_configured at startup. Neither is secret -- the browser sends the
# client id on every login -- so they belong here rather than in a secret store.
# COGNITO_USER_POOL_ID=eu-central-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_REGION=eu-central-1
