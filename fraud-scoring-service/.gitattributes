# Normalise line endings. A CRLF Dockerfile, Makefile or shell script breaks
# inside a Linux container, and this repo is developed on Windows.
* text=auto eol=lf

Dockerfile   text eol=lf
Makefile     text eol=lf
*.py         text eol=lf
*.sh         text eol=lf
*.toml       text eol=lf
*.md         text eol=lf
*.json       text eol=lf

# Binary artifacts — never diffed, never line-ending converted.
*.pickle binary
