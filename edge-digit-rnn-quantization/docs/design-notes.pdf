(def pot_snap\(w, min_exp=-8, max_exp=3\):) Tj
ET
BT
0.1020 0.1020 0.1804 rg
/F4 8.5 Tf
70.00 559.89 Td
(    """Snap weights to nearest power of 2 \(or zero if too small\).""") Tj
ET
BT
0.1020 0.1020 0.1804 rg
/F4 8.5 Tf
70.00 548.89 Td
(    flat = w.flatten\(\)) Tj
ET
BT
0.1020 0.1020 0.1804 rg
/F4 8.5 Tf
70.00 537.89 Td
(    sign = torch.sign\(flat\)) Tj
ET
BT
0.1020 0.1020 0.1804 rg
/F4 8.5 Tf
70.00 526.89 Td
(    abs_w = flat.abs\(\)) Tj
ET
BT
0.1020 0.1020 0.1804 rg
/F4 8.5 Tf
70.00 515.89 Td
(    # Zero out weights below threshold 2^\(min_exp-0.5\)) Tj
ET
BT
0.1020 0.1020 0.1804 rg
/F4 8.5 Tf
70.00 504.89 Td
(    threshold = 2.0 ** \(min_exp - 0.5\)) Tj
ET
BT
0.1020 0.1020 0.1804 rg
/F4 8.5 Tf
70.00 493.89 Td
(    mask = abs_w > threshold) Tj
ET
BT
0.1020 0.1020 0.1804 rg
/F4 8.5 Tf
70.00 482.89 Td
(    log2_w = torch.log2\(abs_w.clamp\(min=1e-30\)\)) Tj
ET
BT
0.1020 0.1020 0.1804 rg
/F4 8.5 Tf
70.00 471.89 Td
(    exp    = log2_w.round\(\).clamp\(min_exp, max_exp\)) Tj
ET
BT
0.1020 0.1020 0.1804 rg
/F4 8.5 Tf
70.00 460.89 Td
(    snapped = sign * \(2.0 ** exp\) * mask.float\(\)) Tj
ET
BT
0.1020 0.1020 0.1804 rg
/F4 8.5 Tf
70.00 449.89 Td
(    return snapped.reshape\(w.shape\)) Tj
ET
